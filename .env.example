# Copy this file to .env and replace only the values for the transport you use.
# Never commit real access tokens or secrets.

# Slack discussion transport
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_CHANNEL=C_REPLACE_ME
SLACK_SIGNING_SECRET=replace-me
SLACK_REVIEWER=U_REPLACE_ME

# Microsoft Teams discussion transport (Microsoft Graph)
TEAMS_GRAPH_TOKEN=replace-with-a-delegated-graph-access-token
TEAMS_TEAM_ID=00000000-0000-0000-0000-000000000000
TEAMS_CHANNEL_ID=19:replace-me@thread.tacv2
# Generate a high-entropy value, for example: openssl rand -hex 32
TEAMS_CLIENT_STATE=replace-with-a-random-webhook-secret
TEAMS_REVIEWER_ID=00000000-0000-0000-0000-000000000000
